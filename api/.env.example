# Soroban RPC endpoint the indexer polls. Default: Testnet. A non-Testnet URL
# requires RWA_REGISTRY_ID and RWA_DIVIDEND_ID. Must be a valid URL (startup fails otherwise).
RWA_RPC_URL=https://soroban-testnet.stellar.org

# Indexer poll interval in seconds (1-3600). Default: 10. Invalid values fail at startup.
# RWA_POLL_INTERVAL_SECS=10

# Deployed contract ids (Testnet defaults from the contracts repo).
RWA_REGISTRY_ID=CBX5SMLTXX6JP4HA5GQIO2V6QM7WCUGL2GZ6D4U773HMRI6RXISKPUR3
RWA_DIVIDEND_ID=CAR4XY3CEBQWFOL27JEWFW34KXSIZA7RFKDQMEIV7ZU723RWY37I2SYX

# A funded account used only as the (unsigned) source for read simulations.
RWA_READ_SOURCE=GAIQGTOBTTLLDJ4SWGGESM7UWJ2DI4K3ZNHUSHPDKJL2IE5FKY3BSRAA

# HTTP port.
PORT=8080

# Log filter.
RUST_LOG=stellar_rwa_api=info,tower_http=warn
